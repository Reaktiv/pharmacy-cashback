# Build-only image: `npm run build` bakes /app/dist into this image at
# build time. docker-compose.prod.yml mounts an empty named volume over
# /app/dist, so Docker auto-seeds that volume from the image on first
# container creation (standard behavior for volumes mounted over
# non-empty image paths) — the nginx service then reads the same volume
# read-only. The container itself does nothing at runtime and exits.
FROM node:22-slim
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm install
COPY . .
RUN npm run build
CMD ["true"]
